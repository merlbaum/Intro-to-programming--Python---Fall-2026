def loan_qualifier():
    MIN_SALARY = 30000.00
    MIN_YEARS = 2

    salary = float(input("Enter annual salary: "))
    years_on_job = int(input("Enter the number of years employed: "))
    # if salary > MIN_SALARY and years_on_job > MIN_YEARS:
    #     print("You qualify for the loan!")
    # else:
    #     print("You did not qualify for loan.")

    if salary > MIN_SALARY:
        if years_on_job > MIN_YEARS:
            print("You qualify for the loan!")
        else:
            print(f"You did not qualify for loan because you must be working there for at least {MIN_YEARS} years.")
    else:
        print(f"You did not qualify for loan because you must be earning at least {MIN_SALARY} dollars.")



def demo10():
    found = False
    search = input("Which name would you like to change? ")
    new_name = input("What would you like to change it to? ")
    with open('names.txt', 'r') as old_file, open('temp.txt', 'w') as temp_file:
        cur_name = old_file.readline().rstrip('\n')
        while cur_name != '': 
            if cur_name == search:
                temp_file.write(f'{new_name}\n')
                found = True
            else:
                temp_file.write(f'{cur_name}\n')
            cur_name = old_file.readline().rstrip('\n')

    os.remove('names.txt')
    os.rename('temp.txt', 'names.txt')
    if found:
        print("The file has been updated.")
    else:
        print("Name was not found.")


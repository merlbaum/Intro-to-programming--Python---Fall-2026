def demo5():
    sales_file = open('sales.txt', "r")
    total_amount = 0
    line = sales_file.readline()
    while line != '':
        if line != '\n': #skips a blank linein the middle of the data
            amount = float(line)
            total_amount += amount
        line = sales_file.readline()
    sales_file.close()
    print(f"Total sales is ${total_amount:.2f}.")



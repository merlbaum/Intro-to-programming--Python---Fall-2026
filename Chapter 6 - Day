def delete_record(file_name, old_id_num):
    found = False
    with open(file_name, 'r') as emp_file, open('temp.txt', 'w') as temp_file :
        name = emp_file.readline().rstrip('\n')
        while name != '':
            id = emp_file.readline().rstrip('\n')
            dept = emp_file.readline().rstrip('\n')
            if id == old_id_num:
                found = True
            else:
                temp_file.write(f'{name}\n')
                temp_file.write(f'{id}\n')
                temp_file.write(f'{dept}\n')
            name = emp_file.readline().rstrip('\n')
    if not found:
        print(f"Employee id {old_id_num} was not found.")
    os.remove(file_name)
    os.rename('temp.txt', file_name)

def change_record(file_name, old_id_num):
    found = False
    with open(file_name, 'r') as emp_file, open('temp.txt', 'w') as temp_file :
        name = emp_file.readline().rstrip('\n')
        while name != '':
            id = emp_file.readline().rstrip('\n')
            dept = emp_file.readline().rstrip('\n')
            if id == old_id_num:
                found = True
                print("Enter data for new employee")
                new_name = input("Name: ")
                new_id_num = input("ID Num: ")
                new_dept = input("Department: ")
                temp_file.write(f'{new_name}\n')
                temp_file.write(f'{new_id_num}\n')
                temp_file.write(f'{new_dept}\n')
            else:
                temp_file.write(f'{name}\n')
                temp_file.write(f'{id}\n')
                temp_file.write(f'{dept}\n')
            name = emp_file.readline().rstrip('\n')
    if not found:
        print(f"Employee id {old_id_num} was not found.")
    os.remove(file_name)
    os.rename('temp.txt', file_name)



def search_record(file_name, id_num):
    found = False
    with open(file_name, 'r') as emp_file:
        name = emp_file.readline().rstrip('\n')
        while name != '' and not found:
            id = emp_file.readline().rstrip('\n')
            dept = emp_file.readline().rstrip('\n')
            if id == id_num:
                found = True
                print(f"Employee data found: ", end=" ")
                print(f"Name: {name} | ID Number: {id} | Dept: {dept}")
            name = emp_file.readline().rstrip('\n')
    if not found:
        print(f"Employee id {id_num} was not found.")

